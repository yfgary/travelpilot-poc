{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelpilot.local/schemas/trip-info-v2.schema.json",
  "title": "TravelPilot Trip Info v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "tripId",
    "overview"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "tripId": {
      "type": "string"
    },
    "overview": {
      "type": "object",
      "additionalProperties": true
    },
    "nav": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "transport": {
      "$ref": "#/$defs/cardSection"
    },
    "car": {
      "$ref": "#/$defs/cardSection"
    },
    "hotelStays": {
      "type": "object",
      "additionalProperties": true
    },
    "parking": {
      "type": "object",
      "additionalProperties": true
    },
    "hardCuts": {
      "type": "object",
      "additionalProperties": true
    },
    "weather": {
      "type": "object",
      "additionalProperties": true
    },
    "checklist": {
      "type": "object",
      "additionalProperties": true
    },
    "emergency": {
      "type": "object",
      "additionalProperties": true
    },
    "customSections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/customSection"
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "properties": {
        "badges": {
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "map": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warning": {
          "type": "string"
        },
        "links": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "cardSection": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "customSection": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "type": {
          "enum": [
            "cards",
            "list",
            "notice",
            "links"
          ]
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "text": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "href"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
