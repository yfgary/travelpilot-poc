{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelpilot.local/schemas/attractions-v3.schema.json",
  "title": "TravelPilot Attractions v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "tripId",
    "attractions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "tripId": {
      "type": "string"
    },
    "attractions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "location",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "localName": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "day": {
            "type": "string"
          },
          "dayNote": {
            "type": "string"
          },
          "status": {
            "enum": [
              "main",
              "backup",
              "optional"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "scoreReason": {
            "type": "string"
          },
          "map": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "number",
            "minimum": 0
          },
          "duration": {
            "type": "string"
          },
          "weatherProfiles": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "summary": {
            "type": "string"
          },
          "info": {
            "type": "string"
          },
          "history": {
            "type": "string"
          },
          "visit": {
            "type": "string"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "access": {
            "type": "string"
          },
          "winter": {
            "type": "string"
          },
          "tips": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "media": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
