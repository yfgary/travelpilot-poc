{
  "contractVersion": "standard-v1",
  "status": "canonical-target",
  "purpose": "TravelPilot shared data contract for every trip. Shared runtime must remain destination-agnostic; trip-specific values live only in trip data.",
  "invariants": {
    "sharedPages": [
      "index.html",
      "itinerary.html",
      "trip-info.html",
      "attractions.html",
      "live.html"
    ],
    "tripFolderAllowedExtensions": [
      ".json",
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".svg"
    ],
    "tripFolderForbiddenExtensions": [
      ".html",
      ".js",
      ".mjs",
      ".css"
    ],
    "rendererTargetMode": "generate",
    "tripSpecificRuntimeAllowed": false,
    "tripSpecificPageAllowed": false,
    "sharedRuntimeDestinationHardcodesAllowed": false
  },
  "requiredDocuments": [
    "trip.json",
    "itinerary.json",
    "trip-info.json",
    "hotels.json",
    "attractions.json",
    "weather.json",
    "live-cams.json"
  ],
  "optionalDocuments": [
    "departure-checklist.json"
  ],
  "featureKeys": [
    "itinerary",
    "tripInfo",
    "attractions",
    "liveCam",
    "todayMode",
    "drivingMode",
    "weather",
    "weatherScore",
    "weatherActivityProfiles",
    "packingChecklist",
    "winterDriving",
    "conditionalDayPlanning"
  ],
  "rendererKeys": [
    "itinerary",
    "tripInfo",
    "attractions",
    "liveCam",
    "weather",
    "todayMode",
    "drivingMode"
  ],
  "rendererModes": {
    "target": [
      "generate"
    ],
    "migrationOnly": [
      "hydrate"
    ]
  },
  "moduleTypes": {
    "conditional-day-planner": {
      "required": [
        "id",
        "type",
        "enabled",
        "strategy",
        "candidateDays",
        "targetRegion",
        "assignments"
      ],
      "strategies": [
        "weather-score"
      ],
      "allowedSelectionModes": [
        "manual",
        "recommended",
        "fixed",
        "read-only"
      ],
      "notes": "Generic planner. targetRegion and assignments are trip data references; the shared engine must never hardcode their concrete ids."
    },
    "weather-comparison": {
      "required": [
        "id",
        "type",
        "enabled",
        "candidateDays",
        "targetRegion"
      ],
      "notes": "Read-only comparison module for future trips that need weather comparison without itinerary reassignment."
    }
  },
  "documentContracts": {
    "trip.json": {
      "required": [
        "contractVersion",
        "id",
        "name",
        "shortName",
        "startDate",
        "endDate",
        "timezone",
        "features",
        "pages",
        "dataFiles",
        "renderers",
        "modules"
      ],
      "idPattern": "^[a-z0-9][a-z0-9-]*$",
      "dateFormat": "YYYY-MM-DD"
    },
    "itinerary.json": {
      "required": [
        "schemaVersion",
        "tripId",
        "days"
      ],
      "dayRequired": [
        "id",
        "day",
        "date",
        "title",
        "route",
        "driving"
      ],
      "dayOptional": [
        "navLabel",
        "weatherRegion",
        "hotelId",
        "items",
        "hardCuts",
        "backups",
        "bonus",
        "constraints",
        "moduleRefs",
        "imagePlan"
      ],
      "timelineRequired": [
        "time",
        "type",
        "title"
      ],
      "timelineOptional": [
        "map",
        "note",
        "attractionId",
        "durationMinutes",
        "hardCut",
        "weatherProfiles"
      ]
    },
    "trip-info.json": {
      "required": [
        "schemaVersion",
        "tripId"
      ],
      "sectionsAreOptional": true,
      "notes": "Renderer must hide absent sections instead of requiring destination-specific page code."
    },
    "hotels.json": {
      "required": [
        "schemaVersion",
        "tripId"
      ],
      "hotelIdentity": [
        "id",
        "name"
      ],
      "notes": "Hotel ids referenced by itinerary/trip-info must resolve here when a hotels document is provided."
    },
    "attractions.json": {
      "required": [
        "schemaVersion",
        "tripId"
      ],
      "attractionIdentity": [
        "id",
        "name"
      ],
      "genericOptional": [
        "location",
        "day",
        "dayNote",
        "status",
        "score",
        "map",
        "duration",
        "weatherProfiles",
        "summary",
        "description",
        "tips",
        "images"
      ]
    },
    "weather.json": {
      "required": [
        "schemaVersion",
        "tripId",
        "regions"
      ],
      "regionRequired": [
        "name",
        "lat",
        "lon"
      ],
      "genericOptional": [
        "timezone",
        "label",
        "type",
        "scoreNote",
        "profiles",
        "activityProfiles"
      ],
      "notes": "Region ids are arbitrary trip data. Dynamic mapping must be declared in data, never in shared code."
    },
    "live-cams.json": {
      "required": [
        "schemaVersion",
        "tripId"
      ],
      "generatedCameraTypes": [
        "youtube",
        "image",
        "link"
      ],
      "notes": "Legacy hydrate data is migration-only; final Standard architecture generates all live content from data."
    },
    "departure-checklist.json": {
      "required": [
        "schemaVersion",
        "title",
        "groups"
      ],
      "groupRequired": [
        "title",
        "items"
      ],
      "itemRequired": [
        "id",
        "label"
      ]
    }
  },
  "referenceRules": [
    "tripId must match containing folder id",
    "registry config path must resolve to that trip folder",
    "itinerary day ids and day numbers must be unique",
    "itinerary dates must be within trip startDate/endDate",
    "hotelId references must resolve when hotels.json is present",
    "attractionId references must resolve when attractions.json is present",
    "weatherRegion must resolve to weather.regions unless explicitly dynamic and backed by a module",
    "moduleRefs must resolve to trip.json modules",
    "all dataFiles declared by trip.json must exist",
    "trip folders must contain data/media only and never executable or page code"
  ]
}
